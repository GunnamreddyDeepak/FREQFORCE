# KISANQUEUE V2 Environment Configuration
# Copy this file to .env and configure values for your local environment.
# Never commit real credentials, passwords, or production secrets to source control.

# Database Configuration (PostgreSQL 17.11 + PostGIS 3.5)
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/kisanqueue

# Application Environment (development, staging, production)
ENVIRONMENT=development

# Redis (Deferred to Phase 2)
REDIS_URL=redis://localhost:6379/0

# Security (Phase 2+)
JWT_SECRET=your_jwt_secret_key_change_in_production

# External Adapters (Phase 2+)
SMS_PROVIDER=mock
SMS_API_KEY=
AI_SERVICE_URL=http://localhost:8001